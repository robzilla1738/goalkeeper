{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GOALKEEPER_HOOK:-${GOALKEEPER_CORE_HOME:-${CODEX_PLUGIN_ROOT:-.}}/bin/goalkeeper_hook.py}\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GOALKEEPER_HOOK:-${GOALKEEPER_CORE_HOME:-${CODEX_PLUGIN_ROOT:-.}}/bin/goalkeeper_hook.py}\""
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GOALKEEPER_HOOK:-${GOALKEEPER_CORE_HOME:-${CODEX_PLUGIN_ROOT:-.}}/bin/goalkeeper_hook.py}\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GOALKEEPER_HOOK:-${GOALKEEPER_CORE_HOME:-${CODEX_PLUGIN_ROOT:-.}}/bin/goalkeeper_hook.py}\""
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GOALKEEPER_HOOK:-${GOALKEEPER_CORE_HOME:-${CODEX_PLUGIN_ROOT:-.}}/bin/goalkeeper_hook.py}\""
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${GOALKEEPER_HOOK:-${GOALKEEPER_CORE_HOME:-${CODEX_PLUGIN_ROOT:-.}}/bin/goalkeeper_hook.py}\""
          }
        ]
      }
    ]
  }
}
